{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageDocumentBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetEncryptionConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:GetBucketVersioning",
        "s3:PutBucketVersioning",
        "s3:GetBucketOwnershipControls",
        "s3:PutBucketOwnershipControls",
        "s3:GetBucketTagging",
        "s3:PutBucketTagging",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::softrobots-document-api-123456789012-ca-central-1",
        "arn:aws:s3:::agent-work-history--123456789012-ca-central-1"
      ]
    },
    {
      "Sid": "ReadLambdaArtifact",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::softrobots-document-api-artifacts-123456789012-ca-central-1/document-api/*"
    },
    {
      "Sid": "ManageDocumentTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DescribeTable",
        "dynamodb:UpdateTable",
        "dynamodb:DeleteTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:ListTagsOfResource",
        "dynamodb:TagResource",
        "dynamodb:UntagResource"
      ],
      "Resource": [
        "arn:aws:dynamodb:ca-central-1:123456789012:table/softrobots-document-api-user-files",
        "arn:aws:dynamodb:ca-central-1:123456789012:table/softrobots-document-api-local-deletions",
        "arn:aws:dynamodb:ca-central-1:123456789012:table/softrobots-projects"
      ]
    },
    {
      "Sid": "ManageUploadFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:DeleteFunction",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:GetPolicy",
        "lambda:PutFunctionConcurrency",
        "lambda:GetFunctionConcurrency",
        "lambda:DeleteFunctionConcurrency",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:ListTags"
      ],
      "Resource": "arn:aws:lambda:ca-central-1:123456789012:function:softrobots-document-api-upload"
    },
    {
      "Sid": "PassOnlyRuntimeToLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::123456789012:role/softrobots-document-api-lambda-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadRuntimeRole",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::123456789012:role/softrobots-document-api-lambda-role"
    },
    {
      "Sid": "ManageOwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:logs:ca-central-1:123456789012:log-group:/softrobots/document-api",
        "arn:aws:logs:ca-central-1:123456789012:log-group:/softrobots/document-api:*"
      ]
    },
    {
      "Sid": "DescribeLogGroups",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ca-central-1"
        }
      }
    },
    {
      "Sid": "CreateTaggedApi",
      "Effect": "Allow",
      "Action": "apigateway:POST",
      "Resource": "arn:aws:apigateway:ca-central-1::/apis",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "softrobots-document-api"
        }
      }
    },
    {
      "Sid": "ManageTaggedApi",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PATCH",
        "apigateway:PUT",
        "apigateway:DELETE"
      ],
      "Resource": "arn:aws:apigateway:ca-central-1::/apis/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "softrobots-document-api",
          "aws:ResourceTag/aws:cloudformation:stack-name": "softrobots-document-api"
        }
      }
    },
    {
      "Sid": "ManageApiTags",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:PUT",
        "apigateway:DELETE"
      ],
      "Resource": "arn:aws:apigateway:ca-central-1::/tags/arn%3Aaws%3Aapigateway%3Aca-central-1%3A%3A%2Fv2%2Fapis%2F*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "softrobots-document-api",
          "aws:ResourceTag/aws:cloudformation:stack-name": "softrobots-document-api"
        }
      }
    },
    {
      "Sid": "TagNewDocumentApi",
      "Effect": "Allow",
      "Action": "apigateway:POST",
      "Resource": "arn:aws:apigateway:ca-central-1::/tags/arn%3Aaws%3Aapigateway%3Aca-central-1%3A%3A%2Fv2%2Fapis%2F*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "softrobots-document-api",
          "aws:RequestTag/aws:cloudformation:stack-name": "softrobots-document-api"
        }
      }
    },
    {
      "Sid": "ManageExistingDocumentStageCollection",
      "Effect": "Allow",
      "Action": "apigateway:*",
      "Resource": "arn:aws:apigateway:ca-central-1::/apis/5u9yppkqed/stages",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ca-central-1"
        }
      }
    },
    {
      "Sid": "TagStagesForExistingDocumentApi",
      "Effect": "Allow",
      "Action": [
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:PATCH"
      ],
      "Resource": [
        "arn:aws:apigateway:ca-central-1::/tags/arn%3Aaws%3Aapigateway%3Aca-central-1%3A%3A%2Fapis%2F5u9yppkqed%2Fstages*",
        "arn:aws:apigateway:ca-central-1::/tags/arn%3Aaws%3Aapigateway%3Aca-central-1%3A%3A%2Fv2%2Fapis%2F5u9yppkqed%2Fstages*"
      ]
    },
    {
      "Sid": "ManageNativeDeviceTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DescribeTable",
        "dynamodb:UpdateTable",
        "dynamodb:DeleteTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:ListTagsOfResource",
        "dynamodb:TagResource",
        "dynamodb:UntagResource",
        "dynamodb:UpdateTimeToLive",
        "dynamodb:DescribeTimeToLive"
      ],
      "Resource": [
        "arn:aws:dynamodb:ca-central-1:123456789012:table/softrobots-native-device-pending",
        "arn:aws:dynamodb:ca-central-1:123456789012:table/softrobots-native-device-approvals",
        "arn:aws:dynamodb:ca-central-1:123456789012:table/softrobots-native-device-nonces"
      ]
    }
  ]
}
