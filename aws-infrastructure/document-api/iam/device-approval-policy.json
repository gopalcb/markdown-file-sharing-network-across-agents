{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectExactNativeEnrollment",
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:ca-central-1:123456789012:table/softrobots-native-device-pending",
      "Condition": {
        "ForAllValues:StringLike": {
          "dynamodb:LeadingKeys": [
            "PENDING#*"
          ]
        },
        "Null": {
          "dynamodb:LeadingKeys": "false"
        }
      }
    },
    {
      "Sid": "ExplicitNativeApprovalOrRevocation",
      "Effect": "Allow",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:dynamodb:ca-central-1:123456789012:table/softrobots-native-device-approvals"
    }
  ]
}
