{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateUpdateDocumentStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateStack",
        "cloudformation:UpdateStack",
        "cloudformation:CreateChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:ca-central-1:123456789012:stack/softrobots-document-api/*",
      "Condition": {
        "StringEquals": {
          "cloudformation:RoleArn": "arn:aws:iam::123456789012:role/softrobots-document-api-cloudformation-role"
        }
      }
    },
    {
      "Sid": "OperateDocumentStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:DeleteStack",
        "cloudformation:ContinueUpdateRollback"
      ],
      "Resource": "arn:aws:cloudformation:ca-central-1:123456789012:stack/softrobots-document-api/*"
    },
    {
      "Sid": "ValidateTemplate",
      "Effect": "Allow",
      "Action": "cloudformation:ValidateTemplate",
      "Resource": "*"
    },
    {
      "Sid": "PassOnlyProvisioner",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::123456789012:role/softrobots-document-api-cloudformation-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PrepareArtifactBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetEncryptionConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:GetBucketVersioning",
        "s3:PutBucketVersioning"
      ],
      "Resource": "arn:aws:s3:::softrobots-document-api-artifacts-123456789012-ca-central-1"
    },
    {
      "Sid": "ListOnlyArtifactPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::softrobots-document-api-artifacts-123456789012-ca-central-1",
      "Condition": {
        "StringLike": {
          "s3:prefix": "document-api/*"
        }
      }
    },
    {
      "Sid": "ManageLambdaArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::softrobots-document-api-artifacts-123456789012-ca-central-1/document-api/*"
    },
    {
      "Sid": "PreflightNativeDeviceRoles",
      "Effect": "Allow",
      "Action": "iam:SimulatePrincipalPolicy",
      "Resource": [
        "arn:aws:iam::123456789012:role/softrobots-document-api-lambda-role",
        "arn:aws:iam::123456789012:role/softrobots-document-api-cloudformation-role"
      ]
    }
  ]
}
