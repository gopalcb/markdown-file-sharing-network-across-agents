{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOnlyDocumentPrefixes",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::agent-work-history--123456789012-ca-central-1/agent-work/raw-markdown/*"
      ]
    },
    {
      "Sid": "ReadUserDocuments",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::softrobots-document-api-123456789012-ca-central-1/docs/user-docs/*",
        "arn:aws:s3:::agent-work-history--123456789012-ca-central-1/agent-work/raw-markdown/*"
      ]
    },
    {
      "Sid": "MaintainUserFileIndex",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:ca-central-1:123456789012:table/softrobots-document-api-user-files"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ca-central-1:123456789012:log-group:/softrobots/document-api:log-stream:*"
    },
    {
      "Sid": "EnrollPendingNativeKeys",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:ca-central-1:123456789012:table/softrobots-native-device-pending",
      "Condition": {
        "ForAllValues:StringLike": {
          "dynamodb:LeadingKeys": [
            "PENDING#*"
          ]
        },
        "Null": {
          "dynamodb:LeadingKeys": "false"
        }
      }
    },
    {
      "Sid": "ReadNativeKeyApproval",
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:ca-central-1:123456789012:table/softrobots-native-device-approvals"
    },
    {
      "Sid": "ConsumeNativeRequestNonce",
      "Effect": "Allow",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:dynamodb:ca-central-1:123456789012:table/softrobots-native-device-nonces"
    },
    {
      "Sid": "BindNativeSession",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:ca-central-1:123456789012:table/softrobots-auth-sessions"
    },
    {
      "Sid": "NeverWriteNativeApprovals",
      "Effect": "Deny",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:PartiQLInsert",
        "dynamodb:PartiQLUpdate",
        "dynamodb:PartiQLDelete"
      ],
      "Resource": "arn:aws:dynamodb:ca-central-1:123456789012:table/softrobots-native-device-approvals"
    },
    {
      "Sid": "NeverRemoveConsumedNonces",
      "Effect": "Deny",
      "Action": [
        "dynamodb:DeleteItem",
        "dynamodb:UpdateItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:PartiQLInsert",
        "dynamodb:PartiQLUpdate",
        "dynamodb:PartiQLDelete"
      ],
      "Resource": "arn:aws:dynamodb:ca-central-1:123456789012:table/softrobots-native-device-nonces"
    },
    {
      "Sid": "RecordLocalDeletionObservations",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem"
      ],
      "Resource": "arn:aws:dynamodb:ca-central-1:123456789012:table/softrobots-document-api-local-deletions"
    },
    {
      "Sid": "NeverDeleteDocumentObjects",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::softrobots-document-api-123456789012-ca-central-1/*",
        "arn:aws:s3:::agent-work-history--123456789012-ca-central-1/*"
      ]
    },
    {
      "Sid": "ReadAndCreatePortalProjects",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:ca-central-1:123456789012:table/softrobots-projects"
    }
  ]
}
